# KiranaTrack Environment Variables (Vite + Supabase)
# Copy this file to .env.local or .env in your root directory

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: In development or demo environments without active Supabase credentials,
# KiranaTrack automatically falls back to local storage caching so all features
# (billing, products, khata, reports, settings, offline PWA) function out-of-the-box.
